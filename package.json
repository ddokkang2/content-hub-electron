{
  "build": {
    "appId": "com.do.contenthub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "package.json"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    },
    "productName": "Content Hub",
    "win": {
      "target": "nsis"
    },
    "electronVersion": "32.0.0"
  },
  "description": "YouTube Studio / X / Instagram / Threads / TikTok Studio를 한 창 안에 webview로 띄우는 Windows용 콘텐츠 허브",
  "devDependencies": {
    "electron": "32.0.0",
    "electron-builder": "24.13.3"
  },
  "main": "main.js",
  "name": "content-hub-electron",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "pack": "electron-builder --win --dir",
    "start": "electron ."
  },
  "version": "1.0.0"
}